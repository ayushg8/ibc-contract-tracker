# Optional. Leave unset to use the Claude Code CLI engine (your Claude subscription).
# If set, the API engine becomes available in Settings -> Engine.
# The app prefers a key stored in the OS keychain over this file.
ANTHROPIC_API_KEY=

# Where the app keeps its database, PDF archive, thumbnails and logs.
# Defaults to ~/Library/Application Support/IBC Contract Tracker
IBC_DATA_DIR=
